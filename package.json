{
  "name": "lgtm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test src/*.test.ts",
    "demo": "node --import tsx src/demo.ts",
    "dev": "node --import tsx --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "setup": "node --import tsx --env-file-if-exists=.env src/setup.ts",
    "action": "node --import tsx src/action.ts"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "probot": "^14.3.2"
  }
}

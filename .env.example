# From the GitHub App settings page
APP_ID=
WEBHOOK_SECRET=
# The full PEM, newlines escaped as \n, in quotes
PRIVATE_KEY=""

# Signs the quiz seal. Any long random string; `openssl rand -base64 32`.
# Rotating it invalidates every open quiz, which is safe — they reissue.
LGTM_SEAL_KEY=

PORT=3000

# Enables the web-explainer section and @lgtm question answering.
# Without it, both are silently skipped and quizzes still post.
ANTHROPIC_API_KEY=

# The app's bot login, for detecting mentions. Defaults to "lgtm".
LGTM_BOT_LOGIN=lgtm
